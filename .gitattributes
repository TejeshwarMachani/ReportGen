# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py text diff=python

# JavaScript/TypeScript
*.js text diff=javascript
*.jsx text diff=javascript
*.ts text diff=typescript
*.tsx text diff=typescript
*.json text

# Markdown
*.md text diff=markdown

# Docker
Dockerfile* text
docker-compose*.yml text

# Configuration
*.yml text
*.yaml text
*.toml text
*.ini text
*.cfg text

# SQL
*.sql text diff=sql

# Shell
*.sh text eol=lf

# Batch
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell
*.ps1 text eol=crlf

# Ignore binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary

# Lock files - don't diff
package-lock.json -diff
yarn.lock -diff
poetry.lock -diff
Pipfile.lock -diff

# Large files - use LFS if needed
# *.db filter=lfs diff=lfs merge=lfs -text
# *.sqlite filter=lfs diff=lfs merge=lfs -text